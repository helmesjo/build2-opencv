# Most of this module's public headers use a plain .h extension rather
# than .hpp, hence the extra h{**} wildcard (the generic "h" target type
# defaults to the .h extension, unaffected by this project's hxx{*}:
# extension = hpp override).
#
pub_hdrs = {hxx ixx txx}{**} h{**}

./: $pub_hdrs

# Install recreating subdirectories.
#
{hxx ixx txx h}{*}:
{
  install         = include/
  install.subdirs = true
}
