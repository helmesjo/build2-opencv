libs =

# test_ccm.cpp and test_inpaint.cpp call imread/imwrite; imgcodecs is
# impl-only in libopencv-photo, but libopencv-ts itself depends on it
# (matching upstream's own ts module dependency list), so it would be
# available transitively via libopencv-ts regardless; kept explicit here
# for clarity.
#
import libs += libopencv-photo%lib{opencv-photo}
import libs += libopencv-imgcodecs%lib{opencv-imgcodecs}
import libs += libopencv-ts%lib{opencv-ts}

exe{libopencv-photo-tests}: {hxx ixx txx cxx}{**} $libs

# Photo_ColorCorrection.compute_color_correction_matrix, .correct_image,
# and .serialization (test_ccm.cpp), and Photo_Inpaint.regression
# (test_inpaint.cpp), read fixture files from the separate opencv_extra
# test-data repository, which this repository does not fetch.
#
skip_tests = "-Photo_ColorCorrection.compute_color_correction_matrix:Photo_ColorCorrection.correct_image:Photo_ColorCorrection.serialization:Photo_Inpaint.regression"

exe{libopencv-photo-tests}:
{
  test = true
  test.arguments = --gtest_brief=1 "--gtest_filter=$skip_tests"
}

cxx.poptions =+ "-I$out_root" "-I$src_root"

# OpenCV's own module sources gate their private headers on this macro
# (upstream's CMake build defines it for every module's own compilation).
#
cxx.poptions += -D__OPENCV_BUILD=1
