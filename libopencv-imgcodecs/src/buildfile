intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

# imgcodecs.hpp includes only opencv2/core.hpp directly, so core is the
# interface dependency; imgproc is implementation-only. Every external
# codec backend (libjpeg, libpng, libtiff, libwebp, OpenEXR, OpenJPEG,
# libspng, GDAL, GDCM, AVIF, JPEG-XL, Jasper) is off for this baseline
# build: each grfmt_*.cpp file is internally guarded on its own HAVE_*
# macro and compiles to a stub/registration-skip when absent, leaving
# built-in support for BMP, PXM/PAM, Sun Raster, Radiance HDR/PFM, GIF,
# and EXIF metadata (no external library needed for any of those).
#
import intf_libs += libopencv-core%lib{opencv-core}
import impl_libs += libopencv-imgproc%lib{opencv-imgproc}

# Public headers.
#
pub = [dir_path] ../include/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

lib{opencv-imgcodecs}: $pub/{$pub_hdrs}

# Private headers and sources as well as dependencies.
#
lib{opencv-imgcodecs}: {hxx ixx txx cxx}{**} $impl_libs $intf_libs

# Build options.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/

cxx.poptions =+ "-I$out_pfx_src" "-I$src_pfx_src" \
                "-I$out_pfx_inc" "-I$src_pfx_inc"

# OpenCV's own module sources gate their private headers on this macro
# (upstream's CMake build defines it for every module's own compilation).
#
cxx.poptions += -D__OPENCV_BUILD=1

# BMP and EXIF-metadata support are unconditionally registered by
# loadsave.cpp with no macro guard at all, but GIF/HDR/Sun-Raster/PXM/PFM
# are gated behind their own HAVE_IMGCODEC_* macros - a separate mechanism
# from the HAVE_JPEG/HAVE_PNG-style flags cvconfig.h controls. Upstream's
# cmake/OpenCVFindLibsGrfmt.cmake sets all five ON by default (mirroring
# WITH_IMGCODEC_* options that default ON, no external library involved),
# so define them here to match; without this, only BMP actually registers
# as a writer/decoder despite this file's own comment above claiming
# PXM/Sun-Raster/HDR-PFM/GIF also work out of the box.
#
cxx.poptions += -DHAVE_IMGCODEC_GIF -DHAVE_IMGCODEC_HDR \
                -DHAVE_IMGCODEC_SUNRASTER -DHAVE_IMGCODEC_PXM \
                -DHAVE_IMGCODEC_PFM

#obja{*}: cxx.poptions += -DOPENCV2_STATIC_BUILD
#objs{*}: cxx.poptions += -DOPENCV2_SHARED_BUILD

# Export options.
#
lib{opencv-imgcodecs}:
{
  cxx.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc" -DHAVE_OPENCV_IMGCODECS
  cxx.export.libs = $intf_libs
}

#liba{opencv-imgcodecs}: cxx.export.poptions += -DOPENCV2_STATIC
#libs{opencv-imgcodecs}: cxx.export.poptions += -DOPENCV2_SHARED

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{opencv-imgcodecs}: bin.lib.version = "-$version.project_id"
else
  lib{opencv-imgcodecs}: bin.lib.version = "-$version.major.$version.minor"

# Don't install private headers.
#
{hxx ixx txx}{*}: install = false
