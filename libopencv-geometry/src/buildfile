intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

# core is part of geometry's own public interface (2d.hpp, 3d.hpp, and
# detail/optimizer.hpp all include opencv2/core headers); flann is used
# only internally (upstream: ocv_define_module(geometry opencv_flann ...)).
#
import intf_libs += libopencv-core%lib{opencv-core}
import impl_libs += libopencv-flann%lib{opencv-flann}

# Public headers.
#
pub = [dir_path] ../include/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

lib{opencv-geometry}: $pub/{$pub_hdrs}

# A few upstream private headers (ap3p.h, epnp.h, p3p.h, polynom_solver.h,
# rho.h, pcc.h) use a plain .h extension, so they are invisible to the
# {hxx ixx txx cxx}{**} wildcard below (this project's hxx{*}: extension =
# hpp mapping) and would otherwise be silently dropped by dist.
#
lib{opencv-geometry}: file{ap3p.h epnp.h p3p.h polynom_solver.h rho.h pcc.h}: include = adhoc

# Private headers and sources as well as dependencies.
#
lib{opencv-geometry}: {hxx ixx txx cxx}{**} $impl_libs $intf_libs

# Build options.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/

cxx.poptions =+ "-I$out_pfx_src" "-I$src_pfx_src" \
                "-I$out_pfx_inc" "-I$src_pfx_inc"

# OpenCV's own module sources gate their private headers on this macro
# (upstream's CMake build defines it for every module's own compilation).
#
cxx.poptions += -D__OPENCV_BUILD=1

#obja{*}: cxx.poptions += -DOPENCV2_STATIC_BUILD
#objs{*}: cxx.poptions += -DOPENCV2_SHARED_BUILD

# Export options.
#
lib{opencv-geometry}:
{
  cxx.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc" -DHAVE_OPENCV_GEOMETRY
  cxx.export.libs = $intf_libs
}

#liba{opencv-geometry}: cxx.export.poptions += -DOPENCV2_STATIC
#libs{opencv-geometry}: cxx.export.poptions += -DOPENCV2_SHARED

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{opencv-geometry}: bin.lib.version = "-$version.project_id"
else
  lib{opencv-geometry}: bin.lib.version = "-$version.major.$version.minor"

# Don't install private headers.
#
{hxx ixx txx}{*}: install = false
