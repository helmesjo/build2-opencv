# Uncomment to suppress warnings coming from external libraries.
#
#cxx.internal.scope = current

cxx.std = 17

using cxx

# M_PI, M_SQRT2, etc. are hidden behind this define on MSVC/MinGW's
# <cmath> (glibc and Apple's libc expose them unconditionally, so this is
# a no-op there), matching upstream's own unconditional
# cmake/OpenCVModule.cmake (ocv_add_module()).
#
cxx.poptions += -D_USE_MATH_DEFINES

# OpenCV fails some tests when char is unsigned by default
# (upstream cmake/OpenCVCompilerOptions.cmake). AArch64 Linux has
# unsigned char. MSVC char is already signed.
#
if ($cxx.class != 'msvc')
  cxx.coptions += -fsigned-char

# MSVC ARM64: uint8x16_t and int8x16_t are aliases unless this is
# defined (cpu_neon.cpp, same cmake file).
#
if ($cxx.class == 'msvc' && $cxx.target.cpu == 'aarch64')
  cxx.poptions += -D_ARM64_DISTINCT_NEON_TYPES

hxx{*}: extension = hpp
ixx{*}: extension = ipp
txx{*}: extension = tpp
cxx{*}: extension = cpp

# test_intrin.cpp/test_intrin_utils.hpp use opencv2/core/hal/intrin.hpp's
# CPU SIMD intrinsics directly (not just through libopencv-core's already
# compiled implementation), so this package needs the same fix as
# libopencv-core's own root.build. NEON is architecturally mandatory on
# aarch64, and at least one Apple clang toolchain confirmed miscompiles
# baseline NEON intrinsics at the compiler's default (no -O flag)
# optimization level, producing silently wrong arithmetic results. -O0
# is not supported on aarch64 here, so it is overridden by appending
# -O1 (later flag wins). A higher -O already present is left alone.
#
if ($cxx.target.cpu == 'aarch64')
{
  if (!$regex.find_match($cxx.coptions $config.cxx.coptions, '[-\/]O[a-zA-Z0-9]') \
      || $regex.find_match($cxx.coptions $config.cxx.coptions, '[-\/]O[0d]'))
    cxx.coptions += -O1
}

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $cxx.target
