# This library is test-support infrastructure for the accompanying
# <pkg>-tests packages: it does not participate in this package's own
# default `./` target set unless config.libopencv_ts.build is true (see
# ../build/root.build), so a bare `b`/`bdep update` here builds nothing
# by default. Importing lib{opencv-ts} directly, as a <pkg>-tests
# package's `require`d dependency does, still resolves and builds it
# regardless of this variable -- `include` only controls default-set
# membership, not target resolution. The declarations below stay
# unconditional (no `if` around them): the build graph itself must not
# vary by configuration, only what gets built by default, per
# HOWTO/config-independent-build-graph.md.
#
./: lib{opencv-ts}: include = $config.libopencv_ts.build

intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

# This package matches upstream's own module dependency list
# (core, imgproc, imgcodecs, videoio, highgui) rather than the minimal
# set ts's own code strictly needs: it exists solely to support the
# <pkg>-tests packages, so there is no benefit to a consumer from
# trimming what it exports, and matching upstream keeps every test file
# that transitively relies on ts.hpp's umbrella includes (imread/imwrite/
# imshow/waitKey without its own #include) working unmodified, along with
# ocl_test.hpp/cuda_test.hpp's own real (non-OpenCL/CUDA-runtime) use of
# imgcodecs/videoio/highgui/core::ocl/core::cuda. All are interface
# dependencies, since ts.hpp itself includes all of them.
# gtest replaces the vendored ts_gtest.h/ts_gtest.cpp (see
# ../include/opencv2/ts.hpp.patch). Linked statically (liba{}, not the
# polymorphic lib{}): the shared variant exports
# -DGTEST_LINKED_AS_SHARED_LIBRARY=1, which precomp.hpp #errors on
# (upstream never supports linking ts against a shared gtest).
#
import intf_libs += libopencv-core%lib{opencv-core}
import intf_libs += libopencv-imgproc%lib{opencv-imgproc}
import intf_libs += libopencv-imgcodecs%lib{opencv-imgcodecs}
import intf_libs += libopencv-videoio%lib{opencv-videoio}
import intf_libs += libopencv-highgui%lib{opencv-highgui}
import intf_libs += gtest%liba{gtest}

# Public headers.
#
pub = [dir_path] ../include/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

lib{opencv-ts}: $pub/{$pub_hdrs}

# Private headers and sources as well as dependencies.
#
lib{opencv-ts}: {hxx ixx txx cxx}{**} $impl_libs $intf_libs

# Build options.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/

cxx.poptions =+ "-I$out_pfx_src" "-I$src_pfx_src" \
                "-I$out_pfx_inc" "-I$src_pfx_inc"

# OpenCV's own module sources gate their private headers on this macro
# (upstream's CMake build defines it for every module's own compilation).
#
cxx.poptions += -D__OPENCV_BUILD=1

#obja{*}: cxx.poptions += -DOPENCV2_STATIC_BUILD
#objs{*}: cxx.poptions += -DOPENCV2_SHARED_BUILD

# Export options.
#
lib{opencv-ts}:
{
  cxx.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc" -DHAVE_OPENCV_TS
  cxx.export.libs = $intf_libs
}

#liba{opencv-ts}: cxx.export.poptions += -DOPENCV2_STATIC
#libs{opencv-ts}: cxx.export.poptions += -DOPENCV2_SHARED

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{opencv-ts}: bin.lib.version = "-$version.project_id"
else
  lib{opencv-ts}: bin.lib.version = "-$version.major.$version.minor"

# Don't install private headers.
#
{hxx ixx txx}{*}: install = false
