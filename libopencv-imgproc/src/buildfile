intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

# core is used throughout imgproc's own public headers; geometry and
# libz (drawing_text.cpp decompresses the gzipped builtin font blobs)
# are implementation-only.
#
# stb_truetype is bundled (not unbundled as a dependency): OpenCV's copy
# is a modified fork with OpenType variable-font support (stbtt_CreateFont,
# stbtt_SetInstance, weight axes, etc.) not present in the vanilla upstream
# library the published stb_truetype build2 package wraps -- confirmed by
# a failed build against it (undeclared stbtt_CreateFont/STBTT_FOURCC/
# stbtt_SetInstance/STBTT_MAX_AXES/stbtt_GetWeight/etc.). Unbundling would
# require either OpenCV's fork to be packaged separately under a different
# name, or the upstream stb_truetype package to gain these extensions.
#
import intf_libs += libopencv-core%lib{opencv-core}
import impl_libs += libopencv-geometry%lib{opencv-geometry}
import impl_libs += libz%lib{z}

# Public headers.
#
pub = [dir_path] ../include/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

lib{opencv-imgproc}: $pub/{$pub_hdrs}

# Private headers and sources as well as dependencies.
#
lib{opencv-imgproc}: {hxx ixx txx cxx}{**} $impl_libs $intf_libs

# Build options.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/

cxx.poptions =+ "-I$out_pfx_src" "-I$src_pfx_src" \
                "-I$out_pfx_inc" "-I$src_pfx_inc"

# OpenCV's own module sources gate their private headers on this macro
# (upstream's CMake build defines it for every module's own compilation).
#
cxx.poptions += -D__OPENCV_BUILD=1

#obja{*}: cxx.poptions += -DOPENCV2_STATIC_BUILD
#objs{*}: cxx.poptions += -DOPENCV2_SHARED_BUILD

# Export options.
#
lib{opencv-imgproc}:
{
  cxx.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc" -DHAVE_OPENCV_IMGPROC
  cxx.export.libs = $intf_libs
}

#liba{opencv-imgproc}: cxx.export.poptions += -DOPENCV2_STATIC
#libs{opencv-imgproc}: cxx.export.poptions += -DOPENCV2_SHARED

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{opencv-imgproc}: bin.lib.version = "-$version.project_id"
else
  lib{opencv-imgproc}: bin.lib.version = "-$version.major.$version.minor"

# Don't install private headers.
#
{hxx ixx txx}{*}: install = false
