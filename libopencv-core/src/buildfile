intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.
import impl_libs += libz%lib{z}

# Public headers.
#
pub = [dir_path] ../include/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

lib{opencv-core}: $pub/{$pub_hdrs}

# Private headers and sources as well as dependencies.
#
# version_string.inc is spliced into system.cpp via a bare preprocessor
# #include, so it is otherwise invisible to the build graph (and would be
# silently dropped by dist, since dist packages what a target depends on,
# not everything reachable on disk).
#
# cvconfig.h is now generated in ../include/buildfile (it must be part of
# this package's exported include/ tree so sibling packages can resolve
# it too); it does not need to be listed as an explicit prerequisite here
# since build2's header dependency extraction discovers it dynamically.
#
lib{opencv-core}: {hxx ixx txx}{**} \
                  cxx{** -simd/*_sse4_1 -simd/*_sse4_2 -simd/*_avx2} \
                  $impl_libs $intf_libs
lib{opencv-core}: file{version_string.inc}: include = adhoc
lib{opencv-core}: $pub/h{cv_cpu_probe}

# CPU dispatch sources: per-ISA TUs compiled with ISA-specific defines and (on
# GCC/Clang) the required march flag. MSVC generates correct SSE4.1/SSE4.2 code
# from intrinsics without /arch:*, but AVX2 requires /arch:AVX2.
#
lib{opencv-core}: cxx{simd/*_sse4_1}: include = ($cxx.target.cpu == 'x86_64')
lib{opencv-core}: cxx{simd/*_sse4_2}: include = ($cxx.target.cpu == 'x86_64')
lib{opencv-core}: cxx{simd/*_avx2}:   include = ($cxx.target.cpu == 'x86_64')

obja{simd/*_sse4_1}: cxx.poptions += -DCV_CPU_DISPATCH_MODE=SSE4_1 -DCV_CPU_COMPILE_SSE4_1=1
objs{simd/*_sse4_1}: cxx.poptions += -DCV_CPU_DISPATCH_MODE=SSE4_1 -DCV_CPU_COMPILE_SSE4_1=1
if ($cxx.class != 'msvc')
{
  obja{simd/*_sse4_1}: cxx.coptions += -msse4.1
  objs{simd/*_sse4_1}: cxx.coptions += -msse4.1
}

obja{simd/*_sse4_2}: cxx.poptions += -DCV_CPU_DISPATCH_MODE=SSE4_2 \
                                      -DCV_CPU_COMPILE_SSE4_2=1 -DCV_CPU_COMPILE_SSE4_1=1
objs{simd/*_sse4_2}: cxx.poptions += -DCV_CPU_DISPATCH_MODE=SSE4_2 \
                                      -DCV_CPU_COMPILE_SSE4_2=1 -DCV_CPU_COMPILE_SSE4_1=1
if ($cxx.class != 'msvc')
{
  obja{simd/*_sse4_2}: cxx.coptions += -msse4.2
  objs{simd/*_sse4_2}: cxx.coptions += -msse4.2
}

obja{simd/*_avx2}: cxx.poptions += -DCV_CPU_DISPATCH_MODE=AVX2 -DCV_CPU_COMPILE_AVX2=1
objs{simd/*_avx2}: cxx.poptions += -DCV_CPU_DISPATCH_MODE=AVX2 -DCV_CPU_COMPILE_AVX2=1
if ($cxx.class == 'msvc')
{
  obja{simd/*_avx2}: cxx.coptions += /arch:AVX2
  objs{simd/*_avx2}: cxx.coptions += /arch:AVX2
}
else
{
  obja{simd/*_avx2}: cxx.coptions += -mavx2
  objs{simd/*_avx2}: cxx.coptions += -mavx2
}

# Build options.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/

cxx.poptions =+ "-I$out_pfx_src" "-I$src_pfx_src" "-I$src_pfx_src/simd" \
                "-I$out_pfx_inc" "-I$src_pfx_inc"

# OpenCV's own module sources gate their private headers on this macro
# (upstream's CMake build defines it for every module's own compilation).
#
cxx.poptions += -D__OPENCV_BUILD=1

# Tell the dispatch machinery (cv_cpu_helper.h's CV_CPU_CALL_*/CV_TRY_*
# macros) which ISA dispatch tiers this module ships. These are per-module
# defines, NOT placed in cv_cpu_config.h, so that other modules that lack
# the corresponding per-ISA TUs are unaffected.
#
if ($cxx.target.cpu == 'x86_64')
  cxx.poptions += -DCV_CPU_DISPATCH_COMPILE_SSE4_1=1 \
                  -DCV_CPU_DISPATCH_COMPILE_SSE4_2=1 \
                  -DCV_CPU_DISPATCH_COMPILE_AVX2=1

# system.cpp calls CoCreateGuid for temp names (upstream issue 19648).
#
if ($cxx.target.class == 'windows')
{
  ole32 = ($cxx.target.system == 'mingw32' ? -lole32 : ole32.lib)
  cxx.libs += $ole32
  liba{opencv-core}: cxx.export.libs += $ole32
}

# system.cpp uses dlopen/dlsym/dladdr (via ld.so) and pthread TLS.
# On POSIX systems these live in separate libraries that the linker
# does not pull in automatically for shared-library builds.
#
if ($cxx.target.class != 'windows')
{
  cxx.libs += -ldl -pthread
  lib{opencv-core}: cxx.export.libs += -ldl -pthread
}

# Upstream's own dllexport/symbol-visibility define for shared builds
# (cvdef.h's CV_EXPORTS), private to this module's own compilation.
#
objs{*}: cxx.poptions += -DCVAPI_EXPORTS

# Export options.
#
lib{opencv-core}:
{
  cxx.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc" -DHAVE_OPENCV_CORE
  cxx.export.libs = $intf_libs
}

#liba{opencv-core}: cxx.export.poptions += -DOPENCV2_STATIC
#libs{opencv-core}: cxx.export.poptions += -DOPENCV2_SHARED

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{opencv-core}: bin.lib.version = "-$version.project_id"
else
  lib{opencv-core}: bin.lib.version = "-$version.major.$version.minor"

# Don't install private headers.
#
{hxx ixx txx}{*}: install = false
