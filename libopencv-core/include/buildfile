# The generic h{**} wildcard catches any upstream public header using a
# plain .h extension (unaffected by this project's hxx{*}: extension = hpp
# override), matching the pattern established in the other opencv packages.
#
pub_hdrs = {hxx ixx txx}{**} h{**}

./: $pub_hdrs

# Install recreating subdirectories.
#
# Headers named private.hpp / *.private.hpp under include/opencv2/ are
# not a stable app API, but every other OpenCV module's precomp.hpp
# includes opencv2/core/private.hpp (and some of the utils/*.private
# headers). Upstream installs this tree. Sibling packages compiled
# against an installed libopencv-core need those files on the include
# path, so they are installed with the rest.
#
{hxx ixx txx h}{*}:
{
  install         = include/
  install.subdirs = true
}

# cv_cpu_config.h is bare-#include'd (no opencv2/ prefix) from the public
# opencv2/core/cv_cpu_dispatch.h, so it must be generated and installed at
# the include/ root, not under opencv2/. The baseline substitution below is
# derived from libbuild2-autoconf's own HAVE_NEON/HAVE_SSE2 builtin checks
# (plus a local HAVE_FP16 check, absent from the builtin catalog, see
# build/autoconf/checks/HAVE_FP16.h) rather than hardcoded, so it reflects
# what the compiler/target actually support: NEON+FP16 on AArch64, SSE2 on
# x86/x86_64, or nothing on an unrecognized target (matching the previous,
# fully-disabled default). On x86_64, SSE4.1, SSE4.2, and AVX2 dispatch
# variants are also configured below.
#
using autoconf

h{cv_cpu_probe}: in{cv_cpu_probe}
h{cv_cpu_probe}: install = false

[rule_hint=cxx.predefs] buildfile{cv_cpu_probe}: h{cv_cpu_probe}
{
  cxx.predefs.poptions = false
  cxx.predefs.default  = 0
  cxx.predefs.macros = HAVE_NEON@have_neon HAVE_SSE2@have_sse2 HAVE_FP16@have_fp16
}

if ($build.meta_operation == 'perform')
{
  update buildfile{cv_cpu_probe}
  source $path(buildfile{cv_cpu_probe})
}
else
{
  have_neon = false
  have_sse2 = false
  have_fp16 = false
}

# Honor NEON only on aarch64. The HAVE_NEON predefs dump is a false
# positive on macOS x86_64 (the SDK ships arm_neon.h). SSE2 is the
# x86/x86_64 baseline.
#
if ($cxx.target.cpu == 'aarch64' && $have_neon != 0 && $have_fp16 != 0)
{
  OPENCV_CPU_BASELINE_DEFINITIONS_CONFIGMAKE = "#define CV_CPU_COMPILE_NEON 1
#define CV_CPU_BASELINE_COMPILE_NEON 1
#define CV_CPU_COMPILE_FP16 1
#define CV_CPU_BASELINE_COMPILE_FP16 1
#define CV_CPU_BASELINE_FEATURES 0 \\
    , CV_CPU_NEON \\
    , CV_CPU_FP16"
}
elif ($cxx.target.cpu == 'aarch64' && $have_neon != 0)
{
  OPENCV_CPU_BASELINE_DEFINITIONS_CONFIGMAKE = "#define CV_CPU_COMPILE_NEON 1
#define CV_CPU_BASELINE_COMPILE_NEON 1
#define CV_CPU_BASELINE_FEATURES 0 \\
    , CV_CPU_NEON"
}
elif (($cxx.target.cpu == 'x86_64' || $cxx.target.cpu == 'i686') && $have_sse2 != 0)
{
  OPENCV_CPU_BASELINE_DEFINITIONS_CONFIGMAKE = "#define CV_CPU_COMPILE_SSE2 1
#define CV_CPU_BASELINE_COMPILE_SSE2 1
#define CV_CPU_BASELINE_FEATURES 0 \\
    , CV_CPU_SSE2"
}
else
  OPENCV_CPU_BASELINE_DEFINITIONS_CONFIGMAKE = '#define CV_CPU_BASELINE_FEATURES 0'

# x86_64: SSE4.1, SSE4.2, and AVX2 dispatch variants.
# CV_CPU_DISPATCH_FEATURES tells the runtime hardware-support database which
# ISA tiers are in play. CV_CPU_DISPATCH_COMPILE_* are NOT set here because
# they activate per-module dispatch code that expects corresponding per-ISA
# TUs to exist; each module that actually ships such TUs sets those defines
# via its own cxx.poptions instead.
#
if ($cxx.target.cpu == 'x86_64')
  OPENCV_CPU_DISPATCH_DEFINITIONS_CONFIGMAKE = "#define CV_CPU_DISPATCH_FEATURES 0 \\
    , CV_CPU_SSE4_1 \\
    , CV_CPU_SSE4_2 \\
    , CV_CPU_AVX2"
else
  OPENCV_CPU_DISPATCH_DEFINITIONS_CONFIGMAKE = '#define CV_CPU_DISPATCH_FEATURES 0'

h{cv_cpu_config}: in{cv_cpu_config} h{cv_cpu_probe}
{
  OPENCV_CPU_BASELINE_DEFINITIONS_CONFIGMAKE = $OPENCV_CPU_BASELINE_DEFINITIONS_CONFIGMAKE
  OPENCV_CPU_DISPATCH_DEFINITIONS_CONFIGMAKE = $OPENCV_CPU_DISPATCH_DEFINITIONS_CONFIGMAKE
}

./: h{cv_cpu_config}
h{cv_cpu_config}: install = include/

# cvconfig.h is bare-#include'd (no opencv2/ prefix) from
# opencv2/core/private.hpp, opencv2/core/private.cuda.hpp, and every other
# OpenCV module's precomp.hpp (which includes private.hpp). It must
# therefore be generated and installed here too, not internally in src/,
# so that sibling packages (which import this library and inherit this
# include/ search path via export.poptions) can resolve it at their own
# compile time. CV_ENABLE_INTRINSICS is the master switch for the
# HAL-vectorized code paths gated by cv_cpu_config.h above; on its own
# (with an empty baseline feature list) it is a no-op, so it is safe to
# leave on unconditionally. Every other optional upstream feature is off
# for this baseline build; only HAVE_INTTYPES_H is true (always available
# on POSIX, per the template's own default).
#
h{cvconfig}: in{cvconfig}
{
  autoconf.flavor = cmake

  BUILD_SHARED_LIBS               = false
  CV_ENABLE_INTRINSICS            = true
  CV_DISABLE_OPTIMIZATION         = false
  HAVE_CLAMDBLAS                  = false
  HAVE_CLAMDFFT                   = false
  HAVE_CLP                        = false
  HAVE_CUDA                       = false
  HAVE_CUBLAS                     = false
  HAVE_CUDNN                      = false
  HAVE_CUFFT                      = false
  HAVE_DIRECTX                    = false
  HAVE_DIRECTX_NV12               = false
  HAVE_D3D11                      = false
  HAVE_D3D10                      = false
  HAVE_D3D9                       = false
  HAVE_EIGEN                      = false
  HAVE_GDAL                       = false
  HAVE_VULKAN                     = false
  HAVE_INTTYPES_H                 = true
  HAVE_IPP                        = false
  HAVE_IPP_ICV                    = false
  HAVE_IPP_IW                     = false
  HAVE_IPP_IW_LL                  = false
  HAVE_OPENJPEG                   = false
  HAVE_JASPER                     = false
  HAVE_AVIF                       = false
  HAVE_JPEG                       = false
  HAVE_JPEGXL                     = false
  HAVE_GDCM                       = false
  HAVE_NVCUVID                    = false
  HAVE_NVCUVID_HEADER             = false
  HAVE_DYNLINK_NVCUVID_HEADER     = false
  HAVE_NVCUVENC                   = false
  HAVE_OPENCL                     = false
  HAVE_OPENCL_STATIC              = false
  HAVE_OPENCL_SVM                 = false
  HAVE_OPENCL_D3D11_NV            = false
  HAVE_OPENEXR                    = false
  HAVE_OPENGL                     = false
  HAVE_PNG                        = false
  HAVE_SPNG                       = false
  HAVE_PTHREAD                    = false
  HAVE_PTHREADS_PF                = false
  HAVE_TBB                        = false
  HAVE_HPX                        = false
  HAVE_TIFF                       = false
  HAVE_VA                         = false
  HAVE_VA_INTEL                   = false
  HAVE_LAPACK                     = false
  ENABLE_INSTRUMENTATION          = false
  OPENCV_TRACE                    = false
  HAVE_UNIFONT                    = false
}

./: h{cvconfig}
h{cvconfig}: install = include/
