intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

# stitching.hpp includes opencv2/core.hpp and opencv2/features.hpp
# directly, so those are interface dependencies. imgproc is also an
# interface dependency: opencv2/stitching/detail/warpers.hpp (reached from
# the public stitching.hpp -> warpers.hpp chain) directly #include's
# opencv2/imgproc.hpp, so consumers need it resolvable too, not just this
# package's own compilation. geometry is implementation-only (pulled in by
# precomp.hpp, not by any public header). flann is genuinely used
# (matchers.cpp), implementation-only. Eigen usage in
# exposure_compensate.cpp is #ifdef HAVE_EIGEN-guarded (off), and the
# optional CUDA/xfeatures2d (opencv_contrib) dependencies are unused with
# CUDA off and contrib unavailable.
#
import intf_libs += libopencv-core%lib{opencv-core}
import intf_libs += libopencv-features%lib{opencv-features}
import intf_libs += libopencv-imgproc%lib{opencv-imgproc}
import impl_libs += libopencv-geometry%lib{opencv-geometry}
import impl_libs += libopencv-flann%lib{opencv-flann}

# Public headers.
#
pub = [dir_path] ../include/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

lib{opencv-stitching}: $pub/{$pub_hdrs}

# Private headers and sources as well as dependencies.
#
lib{opencv-stitching}: {hxx ixx txx cxx}{**} $impl_libs $intf_libs

# Build options.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/

cxx.poptions =+ "-I$out_pfx_src" "-I$src_pfx_src" \
                "-I$out_pfx_inc" "-I$src_pfx_inc"

# OpenCV's own module sources gate their private headers on this macro
# (upstream's CMake build defines it for every module's own compilation).
#
cxx.poptions += -D__OPENCV_BUILD=1

#obja{*}: cxx.poptions += -DOPENCV2_STATIC_BUILD
#objs{*}: cxx.poptions += -DOPENCV2_SHARED_BUILD

# Export options.
#
lib{opencv-stitching}:
{
  cxx.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc" -DHAVE_OPENCV_STITCHING
  cxx.export.libs = $intf_libs
}

#liba{opencv-stitching}: cxx.export.poptions += -DOPENCV2_STATIC
#libs{opencv-stitching}: cxx.export.poptions += -DOPENCV2_SHARED

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{opencv-stitching}: bin.lib.version = "-$version.project_id"
else
  lib{opencv-stitching}: bin.lib.version = "-$version.major.$version.minor"

# Don't install private headers.
#
{hxx ixx txx}{*}: install = false
