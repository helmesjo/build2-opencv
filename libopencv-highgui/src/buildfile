intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

# highgui.hpp includes only opencv2/core.hpp directly (its
# opencv2/imgcodecs.hpp and opencv2/videoio.hpp includes are guarded on
# HAVE_OPENCV_IMGCODECS/HAVE_OPENCV_VIDEOIO, left undefined here,
# consistent with every other optional cross-module integration
# throughout this packaging effort), so core is the only interface
# dependency; imgproc (a mandatory upstream dependency, used internally by
# window.cpp/roiSelector.cpp) is implementation-only.
#
# No GUI toolkit backend (Qt, GTK, Win32, Cocoa, Wayland, framebuffer) is
# available for this baseline build - each window_*.cpp file is
# internally guarded on its own HAVE_* macro and compiles to nothing when
# absent, and window.cpp itself provides a well-defined, fully-supported
# fallback (CV_NO_GUI_ERROR) where every windowing function still exists
# in the public API but throws a clear "not compiled in" exception at
# call time - this is a standard, commonly deployed "headless OpenCV"
# configuration, not a degraded one.
#
import intf_libs += libopencv-core%lib{opencv-core}
import impl_libs += libopencv-imgproc%lib{opencv-imgproc}

# Public headers.
#
pub = [dir_path] ../include/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

lib{opencv-highgui}: $pub/{$pub_hdrs}

# Private headers and sources as well as dependencies.
#
lib{opencv-highgui}: {hxx ixx txx cxx}{**} $impl_libs $intf_libs

# Build options.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/

cxx.poptions =+ "-I$out_pfx_src" "-I$src_pfx_src" \
                "-I$out_pfx_inc" "-I$src_pfx_inc"

# OpenCV's own module sources gate their private headers on this macro
# (upstream's CMake build defines it for every module's own compilation).
#
cxx.poptions += -D__OPENCV_BUILD=1

#obja{*}: cxx.poptions += -DOPENCV2_STATIC_BUILD
#objs{*}: cxx.poptions += -DOPENCV2_SHARED_BUILD

# Export options.
#
lib{opencv-highgui}:
{
  cxx.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc" -DHAVE_OPENCV_HIGHGUI
  cxx.export.libs = $intf_libs
}

#liba{opencv-highgui}: cxx.export.poptions += -DOPENCV2_STATIC
#libs{opencv-highgui}: cxx.export.poptions += -DOPENCV2_SHARED

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{opencv-highgui}: bin.lib.version = "-$version.project_id"
else
  lib{opencv-highgui}: bin.lib.version = "-$version.major.$version.minor"

# Don't install private headers.
#
{hxx ixx txx}{*}: install = false
