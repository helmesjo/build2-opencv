# The generic h{**} wildcard catches any upstream public header using a
# plain .h extension (unaffected by this project's hxx{*}: extension = hpp
# override), matching the pattern established in the other opencv packages.
#
pub_hdrs = {hxx ixx txx}{**} h{**}

./: $pub_hdrs

# Install recreating subdirectories.
#
# container_avi.private.hpp and utils.private.hpp live under
# include/opencv2/videoio/ and are included by this module's sources and
# tests. Upstream installs them. They are installed here too so
# libopencv-videoio-tests can compile against an installed library.
#
{hxx ixx txx h}{*}:
{
  install         = include/
  install.subdirs = true
}
