libs =

# test_tsdf.cpp is patched to include highgui.hpp directly (see
# test_tsdf.cpp.patch), since libopencv-ts's ts.hpp no longer re-exports it
# transitively.
#
import libs += libopencv-ptcloud%lib{opencv-ptcloud}
import libs += libopencv-highgui%lib{opencv-highgui}
import libs += libopencv-ts%lib{opencv-ts}

exe{libopencv-ptcloud-tests}: {hxx ixx txx cxx}{**} $libs
{
  test = true
  test.arguments = --gtest_brief=1
}

cxx.poptions =+ "-I$out_root" "-I$src_root"

# OpenCV's own module sources gate their private headers on this macro
# (upstream's CMake build defines it for every module's own compilation).
#
cxx.poptions += -D__OPENCV_BUILD=1
