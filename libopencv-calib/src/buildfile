intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

# calib.hpp includes only opencv2/core.hpp directly, so core is the
# interface dependency; geometry, imgproc, and features are
# implementation-only (pulled in by precomp.hpp for the calibration
# algorithms, not exposed in the public API). Verified against actual
# source usage, not just the upstream CMakeLists.txt dependency line,
# which also lists objdetect, flann, and stereo - none of which are
# referenced anywhere in this module's own source. The backward-
# compatibility opencv2/calib3d.hpp shim (which does pull in stereo) is
# deliberately not part of this package - see include/buildfile.
#
import intf_libs += libopencv-core%lib{opencv-core}
import impl_libs += libopencv-geometry%lib{opencv-geometry}
import impl_libs += libopencv-imgproc%lib{opencv-imgproc}
import impl_libs += libopencv-features%lib{opencv-features}

# Public headers.
#
pub = [dir_path] ../include/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

lib{opencv-calib}: $pub/{$pub_hdrs}

# Private headers and sources as well as dependencies.
#
lib{opencv-calib}: {hxx ixx txx cxx}{**} $impl_libs $intf_libs

# Build options.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/

cxx.poptions =+ "-I$out_pfx_src" "-I$src_pfx_src" \
                "-I$out_pfx_inc" "-I$src_pfx_inc"

# OpenCV's own module sources gate their private headers on this macro
# (upstream's CMake build defines it for every module's own compilation).
#
cxx.poptions += -D__OPENCV_BUILD=1

#obja{*}: cxx.poptions += -DOPENCV2_STATIC_BUILD
#objs{*}: cxx.poptions += -DOPENCV2_SHARED_BUILD

# Export options.
#
lib{opencv-calib}:
{
  cxx.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc" -DHAVE_OPENCV_CALIB
  cxx.export.libs = $intf_libs
}

#liba{opencv-calib}: cxx.export.poptions += -DOPENCV2_STATIC
#libs{opencv-calib}: cxx.export.poptions += -DOPENCV2_SHARED

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{opencv-calib}: bin.lib.version = "-$version.project_id"
else
  lib{opencv-calib}: bin.lib.version = "-$version.major.$version.minor"

# Don't install private headers.
#
{hxx ixx txx}{*}: install = false
