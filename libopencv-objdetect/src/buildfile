intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

# objdetect.hpp includes opencv2/core.hpp and opencv2/features.hpp
# directly, and its own opencv2/objdetect/mcc_checker_detector.hpp
# sub-header unconditionally includes opencv2/imgproc.hpp (no HAVE_ guard,
# unlike its neighboring opencv2/dnn.hpp include in the same file), so
# core, features, and imgproc are all interface dependencies; only
# geometry is implementation-only. Optional DNN-based face
# detection/recognition and MCC (color checker) support are off for this
# baseline build, consistent with every other optional feature throughout
# this packaging effort.
#
# calibinit.cpp/chessboard.cpp/chessboard.hpp unconditionally use
# cv::flann::Index (no HAVE_OPENCV_FLANN guard, unlike features' optional
# FLANN matcher) - a real dependency the modular CMakeLists.txt does not
# declare (masked in the monolithic upstream build, where every module's
# headers are simultaneously available). flann.hpp is only reached from
# private sources here, so it is implementation-only.
#
import intf_libs += libopencv-core%lib{opencv-core}
import intf_libs += libopencv-features%lib{opencv-features}
import intf_libs += libopencv-imgproc%lib{opencv-imgproc}
import impl_libs += libopencv-geometry%lib{opencv-geometry}
import impl_libs += libopencv-flann%lib{opencv-flann}

# Public headers.
#
pub = [dir_path] ../include/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

lib{opencv-objdetect}: $pub/{$pub_hdrs}

# Private headers and sources as well as dependencies.
#
lib{opencv-objdetect}: {hxx ixx txx cxx}{**} $impl_libs $intf_libs

# Build options.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/

cxx.poptions =+ "-I$out_pfx_src" "-I$src_pfx_src" \
                "-I$out_pfx_inc" "-I$src_pfx_inc"

# OpenCV's own module sources gate their private headers on this macro
# (upstream's CMake build defines it for every module's own compilation).
#
cxx.poptions += -D__OPENCV_BUILD=1

#obja{*}: cxx.poptions += -DOPENCV2_STATIC_BUILD
#objs{*}: cxx.poptions += -DOPENCV2_SHARED_BUILD

# Export options.
#
lib{opencv-objdetect}:
{
  cxx.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc" -DHAVE_OPENCV_OBJDETECT
  cxx.export.libs = $intf_libs
}

#liba{opencv-objdetect}: cxx.export.poptions += -DOPENCV2_STATIC
#libs{opencv-objdetect}: cxx.export.poptions += -DOPENCV2_SHARED

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{opencv-objdetect}: bin.lib.version = "-$version.project_id"
else
  lib{opencv-objdetect}: bin.lib.version = "-$version.major.$version.minor"

# Don't install private headers.
#
{hxx ixx txx}{*}: install = false
