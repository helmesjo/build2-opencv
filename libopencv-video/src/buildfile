intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

# video.hpp -> tracking.hpp includes both opencv2/core.hpp and
# opencv2/imgproc.hpp directly, so both are interface dependencies.
# geometry is unconditionally #include'd by precomp.hpp but no symbol from
# it appears to be referenced anywhere in this module's own source or
# public headers (verified by grep); kept as implementation-only pending
# actual build confirmation, matching the empirical approach used
# throughout this packaging effort. DNN-based trackers (tracker_nano.cpp,
# tracker_dasiamrpn.cpp, tracker_vit.cpp) are #ifdef HAVE_OPENCV_DNN-
# guarded and compile to a reduced API surface with dnn off, same as every
# other optional feature so far.
#
import intf_libs += libopencv-core%lib{opencv-core}
import intf_libs += libopencv-imgproc%lib{opencv-imgproc}
import impl_libs += libopencv-geometry%lib{opencv-geometry}

# Public headers.
#
pub = [dir_path] ../include/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

lib{opencv-video}: $pub/{$pub_hdrs}

# Private headers and sources as well as dependencies.
#
lib{opencv-video}: {hxx ixx txx cxx}{**} $impl_libs $intf_libs

# Build options.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/

cxx.poptions =+ "-I$out_pfx_src" "-I$src_pfx_src" \
                "-I$out_pfx_inc" "-I$src_pfx_inc"

# OpenCV's own module sources gate their private headers on this macro
# (upstream's CMake build defines it for every module's own compilation).
#
cxx.poptions += -D__OPENCV_BUILD=1

#obja{*}: cxx.poptions += -DOPENCV2_STATIC_BUILD
#objs{*}: cxx.poptions += -DOPENCV2_SHARED_BUILD

# Export options.
#
lib{opencv-video}:
{
  cxx.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc" -DHAVE_OPENCV_VIDEO
  cxx.export.libs = $intf_libs
}

#liba{opencv-video}: cxx.export.poptions += -DOPENCV2_STATIC
#libs{opencv-video}: cxx.export.poptions += -DOPENCV2_SHARED

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{opencv-video}: bin.lib.version = "-$version.project_id"
else
  lib{opencv-video}: bin.lib.version = "-$version.major.$version.minor"

# Don't install private headers.
#
{hxx ixx txx}{*}: install = false
